#ifndef PARSE_H
# define PARSE_H
# include <stdlib.h>
# include <string.h>
# include <fcntl.h>
# include <unistd.h>

struct s_node;

typedef struct s_operator
{
	enum e_toktype	type;
	struct s_node	*left;
	struct s_node	*right;
}	t_operator;

enum e_nodetype
{
	OPERATOR,
	TERMINAL,
	MAX_NODETYPE
};

union u_node
{
	t_operator	op;
	t_token		*tokens;
};

typedef struct s_node 
{
	enum e_nodetype	type;
	union u_node	content;
}	t_node;

/* prototypes */

#endif
